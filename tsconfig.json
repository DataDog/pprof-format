{
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": false,
    "module": "Node16",
    "rootDir": "src",
    "moduleResolution": "Node16",
    "declaration": true,
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
